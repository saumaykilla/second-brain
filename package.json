{
  "name": "projectbrain",
  "version": "0.1.0",
  "private": true,
  "description": "ProjectBrain — long-horizon dead-end memory for software teams. Step 0 shared foundation.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:foundation": "tsc -p tsconfig.foundation.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "db:indexes": "node dist/scripts/create-indexes.js",
    "db:load-fixtures": "node dist/scripts/load-fixtures.js",
    "seed:orbit": "node dist/scripts/seed-orbit.js",
    "lint": "echo \"lint: configure eslint after `npm install`\"",
    "test": "echo \"tests: add vitest after `npm install`\""
  },
  "dependencies": {
    "mongodb": "^6.9.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0"
  }
}
