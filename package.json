{
  "name": "projectbrain",
  "version": "0.1.0",
  "private": true,
  "description": "ProjectBrain — long-horizon dead-end memory for software teams.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:setup": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local scripts/db-setup.ts",
    "db:fixtures": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local scripts/load-fixtures.ts",
    "eval": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local scripts/run-eval.ts",
    "reflect": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local scripts/run-reflection.ts"
  },
  "dependencies": {
    "mongodb": "^6.9.0",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
