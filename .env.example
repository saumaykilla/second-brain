# ProjectBrain environment (S5). Copy to .env.local and fill in. NEVER commit real secrets.
# .env* (except this .example) is gitignored.

# --- MongoDB Atlas (system of record; R34) ---
# Atlas connection string for the shared cluster. Both partners connect to the same DB.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="projectbrain"

# Atlas Search / Vector Search index names (created by scripts/create-indexes.ts, S2)
ATLAS_VECTOR_INDEX="attempts_vector"
ATLAS_TEXT_INDEX="attempts_text"

# --- Model providers (R35). Server-side ONLY. Must never reach browser code. ---
# OpenAI: embeddings + structured extraction
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMS="1536"

# OpenRouter: cheap classification (small model) + judge/reflection (strong model)
OPENROUTER_API_KEY=""
OPENROUTER_CLASSIFY_MODEL="openai/gpt-4o-mini"
OPENROUTER_JUDGE_MODEL="openai/gpt-4o"

# --- Slack app (A3) ---
SLACK_SIGNING_SECRET=""
SLACK_BOT_TOKEN=""
SLACK_APP_TOKEN=""

# --- GitHub app (A4) ---
GITHUB_APP_ID=""
GITHUB_WEBHOOK_SECRET=""
GITHUB_PRIVATE_KEY=""

# --- AWS (A5, A8, f-aws-02) ---
AWS_REGION="us-east-1"
EVIDENCE_S3_BUCKET="projectbrain-evidence"

# --- App ---
NODE_ENV="development"
PORT="3001"
# Default project scope for local dev / seed
DEFAULT_PROJECT_ID="orbit"
