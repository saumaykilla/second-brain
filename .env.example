# ProjectBrain environment (S5). Copy to .env.local and fill in. NEVER commit real secrets.
# .env* (except this .example) is gitignored.

# --- MongoDB Atlas (system of record; R34) ---
# Atlas connection string for the shared cluster. Both partners connect to the same DB.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="projectbrain"

# Atlas Search / Vector Search index names (created by scripts/create-indexes.ts, S2)
ATLAS_VECTOR_INDEX="attempts_vector"
ATLAS_TEXT_INDEX="attempts_text"

# --- Model providers (R35). Server-side ONLY. Must never reach browser code. ---
# OpenAI: embeddings + structured extraction
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMS="1536"

# OpenRouter: cheap classification (small model) + judge/reflection (strong model)
OPENROUTER_API_KEY=""
OPENROUTER_CLASSIFY_MODEL="openai/gpt-4o-mini"
OPENROUTER_JUDGE_MODEL="openai/gpt-4o"

# --- Slack app (A3) ---
SLACK_SIGNING_SECRET=""
SLACK_BOT_TOKEN=""
SLACK_APP_TOKEN=""

# --- GitHub app (A4) ---
GITHUB_APP_ID=""
GITHUB_WEBHOOK_SECRET=""
GITHUB_PRIVATE_KEY=""

# --- AWS (evidence storage, worker) ---
AWS_REGION="us-east-1"
EVIDENCE_BUCKET="projectbrain-evidence"

# --- Connect Notion and GitHub (f-a-10). Server-side ONLY. ---
# The browser is sent to the provider; these secrets stay here.
# GitHub OAuth app callback: <APP_URL>/api/sources/github/callback
# Notion public integration redirect: <APP_URL>/api/sources/notion/callback
APP_URL="http://localhost:3000"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

# --- App ---
NODE_ENV="development"
PORT="3001"
# Project every screen reads and writes. "orbit" is the sample fixture; use your own id.
DEFAULT_PROJECT_ID="second-brain"
